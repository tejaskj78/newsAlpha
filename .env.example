# Copy to .env and edit. Every setting in backend/app/config.py can be set here.

# --- Local dev without Docker: SQLite + scheduler inside the API process ---
DATABASE_URL=sqlite:///./newsalpha.db
REDIS_URL=
EMBEDDED_WORKER=true
CORS_ORIGINS=http://localhost:5173

# --- Sentiment ---
# "lexicon" works offline with no key. "llm" gives per-stock reasoning.
SENTIMENT_PROVIDER=lexicon
# Any OpenAI-compatible API. Free options:
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1                        LLM_MODEL=llama-3.1-8b-instant
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
#   Ollama: LLM_BASE_URL=http://localhost:11434/v1                              LLM_MODEL=llama3.1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# --- Engine tuning ---
NEWS_HALF_LIFE_HOURS=18
WEIGHT_NEWS=0.6
WEIGHT_TECHNICAL=0.4
BUY_THRESHOLD=0.25
SELL_THRESHOLD=-0.25

# --- Paper trading ---
PAPER_AUTO_TRADE=false
PAPER_STARTING_CASH=1000000
